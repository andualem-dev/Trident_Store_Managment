generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EquipmentStatus {
  AVAILABLE
  RENTED
  BOOKED
  MAINTENANCE
}

enum RentalStatus {
  ACTIVE
  RETURNED
}

enum BookingStatus {
  UPCOMING
  ACTIVE
  CANCELLED
}

model Operator {
  id            String  @id @default(cuid())
  name          String
  uniqueCode    String  @unique
  passwordHash  String
  passwordPlain String?
  isAdmin       Boolean @default(false)

  rentals   Rental[]
  bookings  Booking[]
  auditLogs AuditLog[]
}

model Customer {
  id              String  @id @default(cuid())
  name            String
  phone           String
  idCardPhotoUrl  String?
  profilePhotoUrl String?
  isBlacklisted   Boolean @default(false)

  guarantors          Guarantor[] @relation("CustomerGuarantors")
  guaranteedFor       Guarantor[] @relation("GuarantorForCustomers")
  rentals    Rental[]
  bookings   Booking[]
}

model Guarantor {
  id                  String @id @default(cuid())
  customerId          String
  guarantorCustomerId String

  customer          Customer @relation("CustomerGuarantors", fields: [customerId], references: [id], onDelete: Cascade)
  guarantorCustomer Customer @relation("GuarantorForCustomers", fields: [guarantorCustomerId], references: [id], onDelete: Cascade)

  @@unique([customerId, guarantorCustomerId])
}

model Equipment {
  id        String          @id @default(cuid())
  name      String
  category  String
  dailyRate Decimal         @db.Decimal(10, 2)
  status    EquipmentStatus @default(AVAILABLE)

  rentalItems RentalItem[]
  bookings    Booking[]
}

model Rental {
  id         String       @id @default(cuid())
  customerId String
  operatorId String
  days       Int
  startAt    DateTime
  dueAt      DateTime
  returnedAt DateTime?
  totalCost  Decimal      @db.Decimal(10, 2)
  lateFee    Decimal      @default(0) @db.Decimal(10, 2)
  status     RentalStatus @default(ACTIVE)

  customer Customer     @relation(fields: [customerId], references: [id])
  operator Operator     @relation(fields: [operatorId], references: [id])
  items    RentalItem[]
}

model RentalItem {
  id          String @id @default(cuid())
  rentalId    String
  equipmentId String

  rental    Rental    @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id])

  @@unique([rentalId, equipmentId])
}

model Booking {
  id          String        @id @default(cuid())
  customerId  String
  operatorId  String
  equipmentId String
  startDate   DateTime
  endDate     DateTime
  status      BookingStatus @default(UPCOMING)

  customer  Customer  @relation(fields: [customerId], references: [id])
  operator  Operator  @relation(fields: [operatorId], references: [id])
  equipment Equipment @relation(fields: [equipmentId], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  operatorId String
  action     String
  entityType String
  entityId   String
  timestamp  DateTime @default(now())
  details    Json

  operator Operator @relation(fields: [operatorId], references: [id])
}

model Settings {
  id                 Int @id @default(1)
  gracePeriodMinutes Int @default(20)
}
