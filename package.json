{
  "name": "trident-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
