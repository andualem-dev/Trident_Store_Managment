# PostgreSQL (local Docker: docker compose up -d)
DATABASE_URL="postgresql://trident:trident@localhost:5432/trident_store?schema=public"

# iron-session requires at least 32 characters
SESSION_SECRET="trident-store-dev-session-secret-change-me"

# Telegram reporting
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""
# Passed to Telegram's setWebhook secret_token parameter
TELEGRAM_WEBHOOK_SECRET=""

# Vercel sends this value as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# Supabase Storage (required on Vercel; optional locally — falls back to ./uploads)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Private bucket name (default: customer-photos)
SUPABASE_STORAGE_BUCKET="customer-photos"
